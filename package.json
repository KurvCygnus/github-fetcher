{
  "name": "@kurvcygnus/github-fetcher",
  "version": "0.1.0",
  "description": "Read-only GitHub MCP server with token auth, proxy routing, and ETag caching",
  "type": "module",
  "bin": {
    "github-fetcher": "dist/index.js",
    "ghf": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KurvCygnus/github-fetcher.git"
  },
  "homepage": "https://github.com/KurvCygnus/github-fetcher#readme",
  "bugs": {
    "url": "https://github.com/KurvCygnus/github-fetcher/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "github",
    "cli",
    "agent-tools",
    "read-only",
    "etag-cache"
  ],
  "author": {
    "name": "Kurv Cygnus"
  },
  "license": "MIT"
}
