{
  "name": "@kurvcygnus/github-fetcher",
  "version": "0.3.0",
  "description": "Read-only GitHub MCP server for AI agents, built for unreliable networks (especially mainland China): 34 tools, token reuse, proxy fallback, ETag cache, one-command setup.",
  "mcpName": "io.github.KurvCygnus/github-fetcher",
  "type": "module",
  "bin": {
    "github-fetcher": "dist/index.js",
    "ghf": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run smoke && npm run verify:launch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KurvCygnus/github-fetcher.git"
  },
  "homepage": "https://github.com/KurvCygnus/github-fetcher#readme",
  "bugs": {
    "url": "https://github.com/KurvCygnus/github-fetcher/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "github",
    "github-mcp",
    "read-only",
    "proxy",
    "rate-limit",
    "etag-cache",
    "china",
    "typescript",
    "cli",
    "ai-agents"
  ],
  "author": {
    "name": "Kurv Cygnus",
    "url": "https://github.com/KurvCygnus"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
